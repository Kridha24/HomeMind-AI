# ==============================================================================
# HomeMind.AI Production Coturn Configuration Example
# ==============================================================================
# Security: DO NOT commit live credentials to version control.
# Copy this file to `turnserver.conf` and populate the static-auth-secret
# with a cryptographically generated 256-bit secret.
#
# Generate secret command:
#   openssl rand -hex 32
# ==============================================================================

# Network Listening Ports
listening-port=3478
tls-listening-port=5349
alt-listening-port=3479
alt-tls-listening-port=5350

# Listening IPs (0.0.0.0 binds to all available interfaces)
listening-ip=0.0.0.0

# External Public IP of your TURN relay server (REQUIRED in NAT/Cloud environments like AWS EC2/GCP GCE)
# external-ip=YOUR_PUBLIC_IP

# Relay UDP Port Range
# Ensure this entire port range is opened in your cloud security groups / firewall
min-port=49152
max-port=65535

# TURN REST API Ephemeral Authentication (RFC 5766 / draft-uberti-behave-turn-rest-00)
# Uses time-limited HMAC-SHA1 tokens generated by HomeMind backend.
use-auth-secret
static-auth-secret=REPLACE_WITH_YOUR_STRONG_HEX_SECRET_FROM_ENV
realm=turn.homemind.ai

# WebRTC & TLS Security Parameters
fingerprint
lt-cred-mech
stale-nonce=600

# TLS Certificate & Key for turns: (Port 5349)
# Provide valid Let's Encrypt / CA certificate for turn.homemind.ai
cert=/etc/coturn/certs/fullchain.pem
pkey=/etc/coturn/certs/privkey.pem
cipher-list="ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384"

# Attack Mitigation & Hardening
no-multicast-peers
no-cli
no-loopback-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=240.0.0.0-255.255.255.255

# Logging & Performance
syslog
verbose
no-stdout-log
allocation-default-lifetime=3600
max-allocate-lifetime=86400
channel-lifetime=600
permission-lifetime=300
