# ==============================================================================
# HomeMind AI — Master Environment Configuration Template
# Classifications: [REQUIRED | OPTIONAL] and [SERVER-ONLY | FRONTEND-PUBLIC]
# Never commit real credentials or production secrets to source control.
# ==============================================================================

# ─── DATABASE [SERVER-ONLY] ──────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string or credentials
POSTGRES_USER=homemind
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=homemind_db
DATABASE_URL=postgresql://homemind:CHANGE_ME_STRONG_PASSWORD@localhost:5432/homemind_db?schema=public

# ─── BACKEND API [SERVER-ONLY] ───────────────────────────────────────────────
# [REQUIRED] Server environment and port
NODE_ENV=development
PORT=5001

# [REQUIRED] Cryptographic secrets for JWT tokens (minimum 32-64 chars)
# Generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX_SECRET_KEY_12345
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_RANDOM_HEX_REFRESH_KEY

# [REQUIRED] Allowed frontend origins for CORS and Socket.IO
FRONTEND_URL=http://localhost:3000

# ─── ASYNCHRONOUS QUEUE & REDIS CACHE [SERVER-ONLY] ───────────────────────────
# [OPTIONAL] Redis connection string for distributed caching and BullMQ queues
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=homemind
DASHBOARD_CACHE_TTL_SECONDS=60
WORKER_CONCURRENCY=5
TRANSACTION_WORKER_CONCURRENCY=5
NOTIFICATION_WORKER_CONCURRENCY=10
AI_WORKER_CONCURRENCY=2
ANALYTICS_WORKER_CONCURRENCY=3
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=3000
OUTBOX_MAX_ATTEMPTS=5


# ─── AI SERVICES [SERVER-ONLY] ───────────────────────────────────────────────
# [OPTIONAL] Fast API AI Vision service endpoint & shared HMAC secret
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=CHANGE_ME_32_CHAR_RANDOM_HEX_SECRET

# [OPTIONAL] External LLM keys
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=

# ─── SMS & EMAIL GATEWAYS [SERVER-ONLY] ──────────────────────────────────────
# [OPTIONAL] Twilio credentials for international SMS verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# [OPTIONAL] Fast2SMS credentials for Indian cellular SMS
FAST2SMS_API_KEY=

# [OPTIONAL] SMTP settings for email OTP notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── WEB CLIENT [FRONTEND-PUBLIC] ────────────────────────────────────────────
# [REQUIRED] API Base URL targeted by browser and mobile clients
VITE_API_URL=http://localhost:5001/api/v1

# [OPTIONAL] Google Identity Services Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# [OPTIONAL] Firebase configuration for client cloud sync
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── LOCAL DEVELOPMENT FLAGS [SERVER-ONLY] ───────────────────────────────────
# [OPTIONAL] In local dev, prints generated OTPs to terminal stdout for zero-cost testing
ALLOW_OTP_CONSOLE=true
